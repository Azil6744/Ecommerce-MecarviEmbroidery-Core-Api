APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================================
# McCarvy production central-auth settings
# ============================================================
# Use these on production:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.mecarviembroidery.com
#
# Core API validates unified-panel tokens against central auth here.
# You can set with or without /api:
#   https://mecarvi.com/auth-api
#   https://mecarvi.com/auth-api/api
CENTRAL_AUTH_URL=https://mecarvi.com/auth-api

# Stripe test mode
# Use pk_test_/sk_test_ keys for Stripe test integration. If STRIPE_SECRET is blank
# in local/testing, membership and order payments accept pm_card_visa/tok_visa only.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# This website slug must match the central auth site registry slug.
MCCARVY_SITE_SLUG=embroidery

# Optional internal/private URL if your server should call central auth over private network.
# Example: http://central-auth:8001 or http://10.0.0.20/auth-api
CENTRAL_AUTH_INTERNAL_URL=

# Browser callers allowed to hit this site API.
SANCTUM_STATEFUL_DOMAINS=my.mecarvi.com,mecarvi.com,www.mecarvi.com,mecarviembroidery.com,www.mecarviembroidery.com,embroidery.mecarvi.com,user.mecarvi.com
CORS_ALLOWED_ORIGINS=https://my.mecarvi.com,https://mecarvi.com,https://www.mecarvi.com,https://mecarviembroidery.com,https://www.mecarviembroidery.com,https://embroidery.mecarvi.com,https://user.mecarvi.com

# Internal secure communications secret key (must match in both central auth and core ecommerce api .env files)
INTERNAL_NOTIFICATION_SECRET=

# Must match Central Auth PIN_AUTHORIZATION_SECRET.
# Used to verify signed PIN authorization tokens for sensitive actions.
PIN_AUTHORIZATION_SECRET=

# User Panel URL (Dynamic: local port e.g. http://localhost:3001 on dev, production user panel URL on server)
USER_PANEL_URL=https://user.mecarvi.com
